App(
    appid="tv_off",
    name="TV Off",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="tv_off_app",
    requires=["gui", "storage", "notification"],
    stack_size=4 * 1024,
    fap_category="Infrared",
    fap_icon="tv_off_10px.png",
    fap_version="1.0",
    fap_author="ryanneufeld",
    fap_description="One-tap TV power-off: sends every TV power code as soon as the app opens",
    fap_weburl="https://github.com/ryanneufeld/flipper-tv-off",
)
